# =============================================================================
# LostFound Backend - Environment Variables TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER put real credentials in this file — it is committed to GitHub.
# =============================================================================

PORT=5000

DB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/LostFound?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

ALLOWED_EMAIL_DOMAIN=anurag.edu.in

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLOUDINARY_FOLDER=lostfound