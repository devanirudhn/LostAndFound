# =============================================================================
# LostFound Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git. Only .env.example is committed.
# =============================================================================

# Server
# Locally use 5000. On Render, PORT is set automatically - leave PORT unset.
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/lostfound?retryWrites=true&w=majority
DB_URL=your_mongodb_atlas_connection_string

# JWT Secret - use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT expiry
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS)
# Local:      http://localhost:5173
# Production: https://your-app-name.vercel.app
FRONTEND_URL=http://localhost:5173

# University email domain restriction
# Only email addresses ending in @this-domain will be allowed to register
# Example: anurag.edu.in
ALLOWED_EMAIL_DOMAIN=anurag.edu.in

# =============================================================================
# Cloudinary - Image Storage
# Get these from: https://cloudinary.com/console
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary folder for uploaded images (optional, customize as you like)
CLOUDINARY_FOLDER=lostfound
